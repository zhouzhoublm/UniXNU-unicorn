 	extern void unicorn_stage_phys(unsigned int slot, unsigned int argb);
 	unicorn_stage_phys(25, 0xFF00A5FF); /* arm_vm_init returned */
+	{
+		extern void unicorn_anchor(unsigned int);
+		unicorn_anchor(15u); /* C40 timing anchor */
+	}
