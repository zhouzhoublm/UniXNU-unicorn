diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 1b30468..963df61 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -64,8 +64,8 @@ unicorn_stage_vm(unsigned int slot, unsigned int argb)
 	unsigned int y = 240u + slot * 80u;
 	unsigned int dy, dx;
 
-	for (dy = 0u; dy < 32u; dy++) {
-		for (dx = 0u; dx < 32u; dx++) {
+	for (dy = 0u; dy < 72u; dy++) {
+		for (dx = 0u; dx < 72u; dx++) {
 			fb[(y + dy) * stride + 64u + dx] = argb;
 		}
 	}
@@ -73,6 +73,72 @@ unicorn_stage_vm(unsigned int slot, unsigned int argb)
 }
 
 
+/*
+ * Unicorn pre-switch diagnostics.  Column 2 (x=192) breadcrumbs mark the
+ * arm_vm_init middle region (root table alloc, physmap tables, segment
+ * extraction, low globals).  An absent square means that step never
+ * completed.
+ *
+ * NOTE: the old unicorn_ttbr_probe() was removed.  It ran after
+ * arm_vm_physmap_init() had populated ptov_table, so its phystokv() calls
+ * returned physmap-aperture VAs that are only mapped in the bootstrap
+ * tables -- the loader tables active before set_mmu_ttb_alternate() have
+ * no mapping there, and the walk aborted the kernel right before the
+ * TTBR1 switch.
+ */
+
+/*
+ * C14 minimal exception vectors: 16 entries x 0x80 bytes, all the same
+ * memory-less stub.  On any exception it waits 240s + 2s*((FAR>>24)&0x3f)
+ * and fires PSCI SYSTEM_RESET, so the adb-return timestamp reports both
+ * the fact and a coarse chunk of the faulting virtual address.
+ */
+extern char unicorn_mini_vectors[];
+
+__asm__(
+    ".text\n"
+    ".align 11\n"
+    ".globl _unicorn_mini_vectors\n"
+"_unicorn_mini_vectors:\n"
+    ".rept 16\n"
+    "  mrs x0, esr_el1\n"
+    "  mrs x1, far_el1\n"
+    "  ubfx x1, x1, #24, #6\n"
+    "  mrs x2, cntfrq_el0\n"
+    "  movz w3, #240\n"
+    "  add x3, x3, x1, lsl #1\n"
+    "  mul x3, x3, x2\n"
+    "  mrs x4, cntvct_el0\n"
+    "1: mrs x5, cntvct_el0\n"
+    "  sub x6, x5, x4\n"
+    "  cmp x6, x3\n"
+    "  b.lo 1b\n"
+    "  movz x0, #0x0009\n"
+    "  movk x0, #0x8400, lsl #16\n"
+    "  smc #0\n"
+    "2: wfi\n"
+    "  b 2b\n"
+    "  .space 0x80 - (17 * 4), 0\n"
+    ".endr\n"
+);
+
+static void
+unicorn_stage_col(unsigned int n, unsigned int argb)
+{
+	volatile unsigned int *fb = (volatile unsigned int *)(unsigned long)0xB8000000UL;
+	unsigned int stride = 5760u / 4u;
+	unsigned int y = 240u + n * 80u;
+	unsigned int dy, dx;
+
+	for (dy = 0u; dy < 72u; dy++) {
+		for (dx = 0u; dx < 72u; dx++) {
+			fb[(y + dy) * stride + 192u + dx] = argb;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+
 #if __ARM_KERNEL_PROTECT__
 /*
  * If we want to support __ARM_KERNEL_PROTECT__, we need a sufficient amount of
@@ -2257,6 +2323,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	cpu_tte = (tt_entry_t *)alloc_ptpage(TRUE);
 	cpu_ttep = kvtophys((vm_offset_t)cpu_tte);
 	bzero(cpu_tte, ARM_PGBYTES);
+	unicorn_stage_col(0, 0xFF00FFFF);
 	avail_end = gPhysBase + gPhysSize; /* bootstrap allocations stay in the primary bank */
 	assert(!(avail_end & PAGE_MASK));
 
@@ -2274,6 +2341,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	 *   the so called physical aperture should be statically mapped
 	 */
 	init_ptpages(cpu_tte, gVirtBase, dynamic_memory_begin, TRUE, ARM_TTE_TABLE_AP(ARM_TTE_TABLE_AP_USER_NA));
+	unicorn_stage_col(1, 0xFF00FF7F);
 
 #if defined(ARM_LARGE_MEMORY)
 	/*
@@ -2364,6 +2432,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	}
 
 	(void) PE_parse_boot_argn("use_contiguous_hint", &use_contiguous_hint, sizeof(use_contiguous_hint));
+	unicorn_stage_col(2, 0xFFFFFF00);
 	assert(segSizePRELINKTEXT < 0x03000000); /* 23355738 */
 
 	/* if one of the new segments is present, the other one better be as well */
@@ -2375,6 +2444,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	sdata = (vm_offset_t) segDATAB;
 	edata = (vm_offset_t) segDATAB + segSizeDATA;
 	end_kern = round_page(segHIGHESTKC ? segHIGHESTKC : getlastkerneladdr()); /* Force end to next page */
+	unicorn_stage_col(3, 0xFFFF8000);
 
 	vm_set_page_size();
 
@@ -2410,6 +2480,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	ptpage_vaddr = alloc_ptpage(TRUE);
 	*cpu_l2_tte = (kvtophys(ptpage_vaddr) & ARM_TTE_TABLE_MASK) | ARM_TTE_TYPE_TABLE | ARM_TTE_VALID | ARM_TTE_TABLE_PXN | ARM_TTE_TABLE_XN;
 	bzero((void *)ptpage_vaddr, ARM_PGBYTES);
+	unicorn_stage_col(4, 0xFFFF00FF);
 
 	/*
 	 * Initialize l2 page table pages :
@@ -2442,13 +2513,109 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 #endif /* CONFIG_CPU_COUNTERS */
 
 	arm_set_user_tbi();
+	unicorn_stage_col(5, 0xFF25F0D8);
+	unicorn_stage_col(6, 0xFF00FF88);
 
 	unicorn_stage_vm(11, 0xFFFF7F00); /* before arm_vm_physmap_init */
 	arm_vm_physmap_init(args);
 	unicorn_stage_vm(12, 0xFF7F00FF); /* arm_vm_physmap_init returned */
 	unicorn_stage_vm(10, 0xFFFF00FF); /* bootstrap tables built, about to switch */
+	unicorn_stage_vm(8, 0xFFFF8000); /* C7: pre-switch marker, overwrites slot 8 blue with orange */
+
+	/*
+	 * C14: catch-all fault reporting.  C13's guarded walk still produced
+	 * no reset, so something faults outside the guarded reads.  Install a
+	 * minimal 16-entry exception vector whose stub performs no memory
+	 * access at all: it reads ESR_EL1/FAR_EL1, waits
+	 * 240s + 2s*((FAR>>24)&0x3f), then fires PSCI SYSTEM_RESET.  Every
+	 * abort between here and the end of the post-switch inspection now
+	 * terminates in a decodable reboot instead of a silent hang.  The
+	 * post-switch walk below keeps its own encoding (2s + 4s*depth,
+	 * +64s/+128s physmap bits) for the no-fault path.
+	 */
+	__asm__ volatile ("msr vbar_el1, %0" :: "r" ((unsigned long)&unicorn_mini_vectors) : "memory");
+	__asm__ volatile ("isb sy" ::: "memory");
+
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
-	unicorn_stage_vm(13, 0xFFFF00A5); /* TTBR1 installed */
+
+	/*
+	 * C16: post-switch verdict, CORRECT L1 indexing.  C15's walk used a
+	 * 9-bit L1 index while this kernel is native-4K with
+	 * __ARM64_PMAP_SUBPAGE_L1__ -- ARM_4K_TT_L1_INDEX_MASK is 0x3fc0000000,
+	 * i.e. only 8 index bits (the mapping code writes via
+	 * L1_TABLE_INDEX()).  The C15 "invalid L1" reading was the probe's own
+	 * bug; the tables are probably fine.  Use the real L1/L2/L3_TABLE_INDEX
+	 * macros now and run the whole verdict AFTER the switch: a reboot here
+	 * with depth 7 proves the TTBR1 switch survived with working tables.
+	 * The V=P tables are still active in TTBR0 (set_mmu_ttb(invalid_ttep)
+	 * comes later), so PA-as-VA reads of the table pages stay valid, and
+	 * the vectors installed before the switch catch any abort.
+	 */
+	{
+		unsigned long kva = (unsigned long)&unicorn_stage_vm;
+		const unsigned long win_lo = gPhysBase;
+		const unsigned long win_hi = gPhysBase + gPhysSize;
+		unsigned long depth = 0;
+		unsigned long delay;
+		tt_entry_t l1e = cpu_tte[L1_TABLE_INDEX(kva)];
+		if (l1e & ARM_TTE_VALID) {
+			depth = 1;
+			if ((l1e & ARM_TTE_TYPE_MASK) == ARM_TTE_TYPE_TABLE) {
+				unsigned long pa = l1e & ARM_TTE_TABLE_MASK;
+				if (pa >= win_lo && pa < win_hi) {
+					const unsigned long *l2 = (const unsigned long *)(unsigned long)pa;
+					unsigned long l2e = l2[L2_TABLE_INDEX(kva)];
+					depth = 2;
+					if (l2e & ARM_TTE_VALID) {
+						depth = 3;
+						if ((l2e & ARM_TTE_TYPE_MASK) == ARM_TTE_TYPE_TABLE) {
+							pa = l2e & ARM_TTE_TABLE_MASK;
+							if (pa >= win_lo && pa < win_hi) {
+								const unsigned long *l3 =
+								    (const unsigned long *)(unsigned long)pa;
+								unsigned long pte = l3[L3_TABLE_INDEX(kva)];
+								depth = 5;
+								if (pte & ARM_TTE_VALID) {
+									depth = 7;
+								}
+							}
+						}
+					}
+				}
+			}
+		}
+		delay = 2 + 4 * depth;
+		{
+			unsigned long pmb = physmap_base;
+			tt_entry_t pe = cpu_tte[L1_TABLE_INDEX(pmb)];
+			if (pe & ARM_TTE_VALID) {
+				delay += 64;
+				if ((pe & ARM_TTE_TYPE_MASK) == ARM_TTE_TYPE_TABLE) {
+					delay += 128;
+				}
+			}
+		}
+		{
+			unsigned long freq, t0, t;
+			__asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (freq));
+			__asm__ volatile ("mrs %0, cntvct_el0" : "=r" (t0));
+			do {
+				__asm__ volatile ("mrs %0, cntvct_el0" : "=r" (t));
+			} while ((t - t0) < freq * delay);
+		}
+		{
+			register unsigned long x0 __asm__("x0") = 0x84000009UL;
+			register unsigned long x1 __asm__("x1") = 0;
+			register unsigned long x2 __asm__("x2") = 0;
+			register unsigned long x3 __asm__("x3") = 0;
+			__asm__ volatile ("smc #0" : "+r" (x0)
+			    : "r" (x1), "r" (x2), "r" (x3)
+			    : "memory", "cc");
+		}
+		for (;;) {
+			__asm__ volatile ("wfi");
+		}
+	}
 
 #if XNU_MONITOR
 	ml_enable_monitor();
