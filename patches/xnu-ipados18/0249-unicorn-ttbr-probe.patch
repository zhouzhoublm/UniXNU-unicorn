diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 1b30468..b1fe77d 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -64,8 +64,8 @@ unicorn_stage_vm(unsigned int slot, unsigned int argb)
 	unsigned int y = 240u + slot * 80u;
 	unsigned int dy, dx;
 
-	for (dy = 0u; dy < 32u; dy++) {
-		for (dx = 0u; dx < 32u; dx++) {
+	for (dy = 0u; dy < 72u; dy++) {
+		for (dx = 0u; dx < 72u; dx++) {
 			fb[(y + dy) * stride + 64u + dx] = argb;
 		}
 	}
@@ -73,6 +73,111 @@ unicorn_stage_vm(unsigned int slot, unsigned int argb)
 }
 
 
+/*
+ * Unicorn pre-switch diagnostics.  Column 2 (x=192) breadcrumbs mark the
+ * arm_vm_init middle region (root table alloc, physmap tables, segment
+ * extraction, low globals).  An absent square means that step never
+ * completed.
+ *
+ * NOTE: the old unicorn_ttbr_probe() was removed.  It ran after
+ * arm_vm_physmap_init() had populated ptov_table, so its phystokv() calls
+ * returned physmap-aperture VAs that are only mapped in the bootstrap
+ * tables -- the loader tables active before set_mmu_ttb_alternate() have
+ * no mapping there, and the walk aborted the kernel right before the
+ * TTBR1 switch.
+ */
+
+static void
+unicorn_stage_col(unsigned int n, unsigned int argb)
+{
+	volatile unsigned int *fb = (volatile unsigned int *)(unsigned long)0xB8000000UL;
+	unsigned int stride = 5760u / 4u;
+	unsigned int y = 240u + n * 80u;
+	unsigned int dy, dx;
+
+	for (dy = 0u; dy < 72u; dy++) {
+		for (dx = 0u; dx < 72u; dx++) {
+			fb[(y + dy) * stride + 192u + dx] = argb;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * C18: post-switch breadcrumbs.  After set_mmu_ttb(invalid_ttep) the V=P
+ * identity map is gone, so the frame buffer PA can no longer be reached
+ * as a low VA.  Map the frame buffer (8 MiB) into the new tables at a
+ * dedicated VA above the static map, and paint breadcrumbs through that
+ * mapping for every milestone past the switch.
+ */
+vm_offset_t unicorn_fb_va;
+
+void
+unicorn_stage_phys(unsigned int slot, unsigned int argb)
+{
+	volatile unsigned int *fb;
+
+	if (unicorn_fb_va == 0) {
+		return;
+	}
+	fb = (volatile unsigned int *)(unsigned long)unicorn_fb_va;
+	unsigned int stride = 5760u / 4u;
+	/*
+	 * Slots >= 25 reuse the rows of the early column-1 slots (0..7):
+	 * those squares are long consumed and their rows sit deep inside the
+	 * 12 MiB fb mapping, so high slot numbers can never spill past the
+	 * last mapped 2 MiB block.
+	 */
+	unsigned int row_slot = (slot >= 25u) ? (slot - 25u) : slot;
+	unsigned int y = 240u + row_slot * 80u;
+	unsigned int dy, dx;
+
+	for (dy = 0u; dy < 72u; dy++) {
+		for (dx = 0u; dx < 72u; dx++) {
+			fb[(y + dy) * stride + 64u + dx] = argb;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * C22 minimal exception vectors: 16 entries x 0x80 bytes, all sharing one
+ * memory-less stub.  On ANY exception it reads ESR_EL1, waits
+ * 240s + 4s*((ESR>>26)&0x3f) and fires PSCI SYSTEM_RESET, so every abort
+ * in the post-platform init chain terminates in a decodable reboot (the
+ * adb-return timestamp reports the exception class EC).  No memory access
+ * at all: safe in any MMU state, including mid-wedge.
+ */
+extern char unicorn_mini_vectors[];
+
+__asm__(
+    ".text\n"
+    ".align 11\n"
+    ".globl _unicorn_mini_vectors\n"
+"_unicorn_mini_vectors:\n"
+    ".rept 16\n"
+    "  msr daifset, #0xf\n"
+    "  mrs x0, esr_el1\n"
+    "  ubfx x0, x0, #26, #6\n"
+    "  movz w3, #240\n"
+    "  add x3, x3, x0, lsl #2\n"
+    "  mrs x2, cntfrq_el0\n"
+    "  mul x3, x3, x2\n"
+    "  mrs x4, cntvct_el0\n"
+    "1: mrs x5, cntvct_el0\n"
+    "  sub x6, x5, x4\n"
+    "  cmp x6, x3\n"
+    "  b.lo 1b\n"
+    "  movz x0, #0x0009\n"
+    "  movk x0, #0x8400, lsl #16\n"
+    "  smc #0\n"
+    "2: wfi\n"
+    "  b 2b\n"
+    "  .space 0x80 - (16 * 4), 0\n"
+    ".endr\n"
+);
+
+
 #if __ARM_KERNEL_PROTECT__
 /*
  * If we want to support __ARM_KERNEL_PROTECT__, we need a sufficient amount of
@@ -2257,6 +2362,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	cpu_tte = (tt_entry_t *)alloc_ptpage(TRUE);
 	cpu_ttep = kvtophys((vm_offset_t)cpu_tte);
 	bzero(cpu_tte, ARM_PGBYTES);
+	unicorn_stage_col(0, 0xFF00FFFF);
 	avail_end = gPhysBase + gPhysSize; /* bootstrap allocations stay in the primary bank */
 	assert(!(avail_end & PAGE_MASK));
 
@@ -2274,6 +2380,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	 *   the so called physical aperture should be statically mapped
 	 */
 	init_ptpages(cpu_tte, gVirtBase, dynamic_memory_begin, TRUE, ARM_TTE_TABLE_AP(ARM_TTE_TABLE_AP_USER_NA));
+	unicorn_stage_col(1, 0xFF00FF7F);
 
 #if defined(ARM_LARGE_MEMORY)
 	/*
@@ -2364,6 +2471,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	}
 
 	(void) PE_parse_boot_argn("use_contiguous_hint", &use_contiguous_hint, sizeof(use_contiguous_hint));
+	unicorn_stage_col(2, 0xFFFFFF00);
 	assert(segSizePRELINKTEXT < 0x03000000); /* 23355738 */
 
 	/* if one of the new segments is present, the other one better be as well */
@@ -2375,6 +2483,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	sdata = (vm_offset_t) segDATAB;
 	edata = (vm_offset_t) segDATAB + segSizeDATA;
 	end_kern = round_page(segHIGHESTKC ? segHIGHESTKC : getlastkerneladdr()); /* Force end to next page */
+	unicorn_stage_col(3, 0xFFFF8000);
 
 	vm_set_page_size();
 
@@ -2410,6 +2519,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	ptpage_vaddr = alloc_ptpage(TRUE);
 	*cpu_l2_tte = (kvtophys(ptpage_vaddr) & ARM_TTE_TABLE_MASK) | ARM_TTE_TYPE_TABLE | ARM_TTE_VALID | ARM_TTE_TABLE_PXN | ARM_TTE_TABLE_XN;
 	bzero((void *)ptpage_vaddr, ARM_PGBYTES);
+	unicorn_stage_col(4, 0xFFFF00FF);
 
 	/*
 	 * Initialize l2 page table pages :
@@ -2442,13 +2552,34 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 #endif /* CONFIG_CPU_COUNTERS */
 
 	arm_set_user_tbi();
+	unicorn_stage_col(5, 0xFF25F0D8);
+	unicorn_stage_col(6, 0xFF00FF88);
 
 	unicorn_stage_vm(11, 0xFFFF7F00); /* before arm_vm_physmap_init */
+
+	/*
+	 * C18: map the frame buffer into the new tables.  Placed BEFORE
+	 * arm_vm_physmap_init() so arm_kva_to_tte()'s phystokv() still uses
+	 * the gVirtBase default path (ptov_table is not populated yet) and
+	 * the table-page writes are deterministic.  6 x 2 MiB blocks cover
+	 * breadcrumb rows up to ~2000.
+	 */
+	unicorn_fb_va = (physmap_end + ARM_TT_L2_OFFMASK) & ~ARM_TT_L2_OFFMASK;
+	init_ptpages(cpu_tte, unicorn_fb_va, unicorn_fb_va + 6 * ARM_TT_L2_SIZE, FALSE,
+	    ARM_DYNAMIC_TABLE_XN | ARM_TTE_TABLE_AP(ARM_TTE_TABLE_AP_USER_NA));
+	for (unsigned long i = 0; i < 6; i++) {
+		tt_entry_t *tte2 = arm_kva_to_tte(unicorn_fb_va + i * ARM_TT_L2_SIZE);
+		*tte2 = ((0xB8000000ULL + i * ARM_TT_L2_SIZE) & ARM_TTE_BLOCK_L2_MASK)
+		    | ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX
+		    | ARM_TTE_BLOCK_AP(AP_RWNA) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE);
+	}
+
 	arm_vm_physmap_init(args);
 	unicorn_stage_vm(12, 0xFF7F00FF); /* arm_vm_physmap_init returned */
 	unicorn_stage_vm(10, 0xFFFF00FF); /* bootstrap tables built, about to switch */
+	unicorn_stage_vm(8, 0xFFFF8000); /* C7: pre-switch marker, overwrites slot 8 blue with orange */
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
-	unicorn_stage_vm(13, 0xFFFF00A5); /* TTBR1 installed */
+	unicorn_stage_vm(13, 0xFFFF00A5); /* TTBR1 installed (PA fb via V=P, still alive here) */
 
 #if XNU_MONITOR
 	ml_enable_monitor();
@@ -2458,6 +2589,16 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	flush_mmu_tlb();
 	kva_active = TRUE;
+	unicorn_stage_phys(14, 0xFF00FFFF); /* identity retired, physmap world */
+
+	/*
+	 * C22: install the memory-less exception vectors.  From here until
+	 * machine_startup every abort reports its exception class through the
+	 * PSCI reset timing (240s + 4s*EC) instead of hanging silently.
+	 */
+	__asm__ volatile ("msr vbar_el1, %0" :: "r" ((unsigned long)unicorn_mini_vectors) : "memory");
+	__asm__ volatile ("isb sy" ::: "memory");
+
 	// global table pointers may need to be different due to physical aperture remapping
 	cpu_tte = (tt_entry_t*)(phystokv(cpu_ttep));
 	invalid_tte = (tt_entry_t*)(phystokv(invalid_ttep));
@@ -2679,6 +2820,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 #endif
 	first_avail = avail_start;
 	patch_low_glo_static_region(args->topOfKernelData, avail_start - args->topOfKernelData);
+	unicorn_stage_phys(15, 0xFF00FF7F); /* arm_vm_init complete */
 	enable_preemption();
 }
 
diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -630,128 +630,159 @@ arm_init(
 	arm_vm_init(xmaxmem, args);
+	extern void unicorn_stage_phys(unsigned int slot, unsigned int argb);
+	unicorn_stage_phys(25, 0xFF00A5FF); /* arm_vm_init returned */

 #if defined(PONG) && defined(XNU_PONG_RAMOOPS_CONSOLE) && XNU_PONG_RAMOOPS_CONSOLE
 	(void)pong_ramoops_console_init();
+	unicorn_stage_phys(26, 0xFFA5FF00); /* past pong ramoops console */
 #endif

 	if (debug_boot_arg) {
 		patch_low_glo();
+	unicorn_stage_phys(27, 0xFFFF00A5); /* past patch_low_glo */
 	}

 #if __arm64__ && WITH_CLASSIC_S2R
 	sleep_token_buffer_init();
 #endif

 	PE_consistent_debug_inherit();
+	unicorn_stage_phys(28, 0xFF8000FF); /* consistent debug inherit */

 	/* Setup debugging output. */
 	const unsigned int serial_exists = serial_init();
+	unicorn_stage_phys(29, 0xFF0080FF); /* serial init */
 	kernel_startup_initialize_upto(STARTUP_SUB_KPRINTF);
+	unicorn_stage_phys(30, 0xFFFFFFFF); /* startup upto KPRINTF */
 	kprintf("kprintf initialized\n");
+	unicorn_stage_phys(31, 0xFFFF0000); /* kprintf survived - console writes work! */
 #if defined(PONG)
     printf("Pong RAM: %u owned banks, %llu MiB managed before kernel reservations, 4 KiB pages\n",
         pong_ram_range_count, pong_ram_bytes >> 20);
 #endif

 	serialmode = 0;
 	if (PE_parse_boot_argn("serial", &serialmode, sizeof(serialmode))) {
 		/* Do we want a serial keyboard and/or console? */
 		kprintf("Serial mode specified: %08X\n", serialmode);
 		disable_iolog_serial_output = (serialmode & SERIALMODE_NO_IOLOG) != 0;
 		enable_dklog_serial_output = restore_boot || (serialmode & SERIALMODE_DKLOG) != 0;
 		int force_sync = serialmode & SERIALMODE_SYNCDRAIN;
 		if (force_sync || PE_parse_boot_argn("drain_uart_sync", &force_sync, sizeof(force_sync))) {
 			if (force_sync) {
 				serialmode |= SERIALMODE_SYNCDRAIN;
 				kprintf(
 					"WARNING: Forcing uart driver to output synchronously."
 					"printf()s/IOLogs will impact kernel performance.\n"
 					"You are advised to avoid using 'drain_uart_sync' boot-arg.\n");
 			}
 		}
 		/* If on-demand is selected, disable serials until reception. */
 		bool on_demand = !!(serialmode & SERIALMODE_ON_DEMAND);
 		if (on_demand && !(serialmode & SERIALMODE_INPUT)) {
 			kprintf(
 				"WARNING: invalid serial boot-args : ON_DEMAND (0x%x) flag "
 				"requires INPUT(0x%x). Ignoring ON_DEMAND.\n",
 				SERIALMODE_ON_DEMAND, SERIALMODE_INPUT
 				);
 			on_demand = 0;
 		}
 		serial_set_on_demand(on_demand);
 	}
 	if (kern_feature_override(KF_SERIAL_OVRD)) {
 		serialmode = 0;
 	}

 	/* Start serial if requested and a serial device was enumerated in serial_init(). */
 	if ((serialmode & SERIALMODE_OUTPUT) && serial_exists) {
 		serial_console_enabled = true;
 		(void)switch_to_serial_console(); /* Switch into serial mode from video console */
 		disableConsoleOutput = FALSE;     /* Allow printfs to happen */
 	}
 	PE_create_console();
+	unicorn_stage_phys(16, 0xFF00FFFF); /* console up */

 	/* setup console output */
 	PE_init_printf(FALSE);

 #if __arm64__
 #if DEBUG
 	dump_kva_space();
 #endif
 #endif

 	cpu_machine_idle_init(TRUE);

 	PE_init_platform(TRUE, &BootCpuData);

 	/* Initialize the debug infrastructure system-wide and on the local core. */
 	pe_arm_debug_init_early(&BootCpuData);

 #if __arm64__
 	extern bool cpu_config_correct;
 	if (!cpu_config_correct) {
 		panic("The cpumask=N boot arg cannot be used together with cpus=N, and the boot CPU must be enabled");
 	}

 	ml_map_cpu_pio();

 #if APPLE_ARM64_ARCH_FAMILY
 	configure_late_apple_regs(true);
 #endif

 #endif

 	cpu_timebase_init(TRUE);

 #if KPERF
 	/* kptimer_curcpu_up() must be called after cpu_timebase_init */
 	kptimer_curcpu_up();
 #endif /* KPERF */

 	PE_init_cpu();
 #if __arm64__
 	apt_msg_init();
 	apt_msg_init_cpu();
 #endif
 	fiq_context_init(TRUE);


 #if HIBERNATION
 	pal_hib_init();
 #endif /* HIBERNATION */

 	/*
 	 * Initialize the stack protector for all future calls
 	 * to C code. Since kernel_bootstrap() eventually
 	 * switches stack context without returning through this
 	 * function, we do not risk failing the check even though
 	 * we mutate the guard word during execution.
 	 */
 	__stack_chk_guard = (unsigned long)early_random();
 	/* Zero a byte of the protector to guard
 	 * against string vulnerabilities
 	 */
 	__stack_chk_guard &= ~(0xFFULL << 8);
+	unicorn_stage_phys(18, 0xFFFFFF00); /* about to run machine_startup */
+	{
+		unsigned long freq, t0, t;
+		__asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (freq));
+		__asm__ volatile ("mrs %0, cntvct_el0" : "=r" (t0));
+		do {
+			__asm__ volatile ("mrs %0, cntvct_el0" : "=r" (t));
+		} while ((t - t0) < freq * 200u);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		{
+			register unsigned long x0 __asm__("x0") = 0x84000009UL;
+			register unsigned long x1 __asm__("x1") = 0;
+			register unsigned long x2 __asm__("x2") = 0;
+			register unsigned long x3 __asm__("x3") = 0;
+			__asm__ volatile ("smc #0" : "+r" (x0)
+			    : "r" (x1), "r" (x2), "r" (x3)
+			    : "memory", "cc");
+		}
+		for (;;) {
+			__asm__ volatile ("wfi");
+		}
+	}
 	machine_startup(args);
 }
