diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 1b30468..f0f95d4 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -64,8 +64,8 @@ unicorn_stage_vm(unsigned int slot, unsigned int argb)
 	unsigned int y = 240u + slot * 80u;
 	unsigned int dy, dx;
 
-	for (dy = 0u; dy < 32u; dy++) {
-		for (dx = 0u; dx < 32u; dx++) {
+	for (dy = 0u; dy < 72u; dy++) {
+		for (dx = 0u; dx < 72u; dx++) {
 			fb[(y + dy) * stride + 64u + dx] = argb;
 		}
 	}
@@ -73,6 +73,37 @@ unicorn_stage_vm(unsigned int slot, unsigned int argb)
 }
 
 
+/*
+ * Unicorn pre-switch diagnostics.  Column 2 (x=192) breadcrumbs mark the
+ * arm_vm_init middle region (root table alloc, physmap tables, segment
+ * extraction, low globals).  An absent square means that step never
+ * completed.
+ *
+ * NOTE: the old unicorn_ttbr_probe() was removed.  It ran after
+ * arm_vm_physmap_init() had populated ptov_table, so its phystokv() calls
+ * returned physmap-aperture VAs that are only mapped in the bootstrap
+ * tables -- the loader tables active before set_mmu_ttb_alternate() have
+ * no mapping there, and the walk aborted the kernel right before the
+ * TTBR1 switch.
+ */
+
+static void
+unicorn_stage_col(unsigned int n, unsigned int argb)
+{
+	volatile unsigned int *fb = (volatile unsigned int *)(unsigned long)0xB8000000UL;
+	unsigned int stride = 5760u / 4u;
+	unsigned int y = 240u + n * 80u;
+	unsigned int dy, dx;
+
+	for (dy = 0u; dy < 72u; dy++) {
+		for (dx = 0u; dx < 72u; dx++) {
+			fb[(y + dy) * stride + 192u + dx] = argb;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+
 #if __ARM_KERNEL_PROTECT__
 /*
  * If we want to support __ARM_KERNEL_PROTECT__, we need a sufficient amount of
@@ -2257,6 +2288,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	cpu_tte = (tt_entry_t *)alloc_ptpage(TRUE);
 	cpu_ttep = kvtophys((vm_offset_t)cpu_tte);
 	bzero(cpu_tte, ARM_PGBYTES);
+	unicorn_stage_col(0, 0xFF00FFFF);
 	avail_end = gPhysBase + gPhysSize; /* bootstrap allocations stay in the primary bank */
 	assert(!(avail_end & PAGE_MASK));
 
@@ -2274,6 +2306,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	 *   the so called physical aperture should be statically mapped
 	 */
 	init_ptpages(cpu_tte, gVirtBase, dynamic_memory_begin, TRUE, ARM_TTE_TABLE_AP(ARM_TTE_TABLE_AP_USER_NA));
+	unicorn_stage_col(1, 0xFF00FF7F);
 
 #if defined(ARM_LARGE_MEMORY)
 	/*
@@ -2364,6 +2397,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	}
 
 	(void) PE_parse_boot_argn("use_contiguous_hint", &use_contiguous_hint, sizeof(use_contiguous_hint));
+	unicorn_stage_col(2, 0xFFFFFF00);
 	assert(segSizePRELINKTEXT < 0x03000000); /* 23355738 */
 
 	/* if one of the new segments is present, the other one better be as well */
@@ -2375,6 +2409,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	sdata = (vm_offset_t) segDATAB;
 	edata = (vm_offset_t) segDATAB + segSizeDATA;
 	end_kern = round_page(segHIGHESTKC ? segHIGHESTKC : getlastkerneladdr()); /* Force end to next page */
+	unicorn_stage_col(3, 0xFFFF8000);
 
 	vm_set_page_size();
 
@@ -2410,6 +2445,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	ptpage_vaddr = alloc_ptpage(TRUE);
 	*cpu_l2_tte = (kvtophys(ptpage_vaddr) & ARM_TTE_TABLE_MASK) | ARM_TTE_TYPE_TABLE | ARM_TTE_VALID | ARM_TTE_TABLE_PXN | ARM_TTE_TABLE_XN;
 	bzero((void *)ptpage_vaddr, ARM_PGBYTES);
+	unicorn_stage_col(4, 0xFFFF00FF);
 
 	/*
 	 * Initialize l2 page table pages :
@@ -2442,13 +2478,44 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 #endif /* CONFIG_CPU_COUNTERS */
 
 	arm_set_user_tbi();
+	unicorn_stage_col(5, 0xFF25F0D8);
+	unicorn_stage_col(6, 0xFF00FF88);
 
 	unicorn_stage_vm(11, 0xFFFF7F00); /* before arm_vm_physmap_init */
 	arm_vm_physmap_init(args);
 	unicorn_stage_vm(12, 0xFF7F00FF); /* arm_vm_physmap_init returned */
 	unicorn_stage_vm(10, 0xFFFF00FF); /* bootstrap tables built, about to switch */
+	unicorn_stage_vm(8, 0xFFFF8000); /* C7: pre-switch marker, overwrites slot 8 blue with orange */
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
-	unicorn_stage_vm(13, 0xFFFF00A5); /* TTBR1 installed */
+
+	/*
+	 * C11: pure-register post-switch verdict.  No memory access at all
+	 * after the switch (no framebuffer, no phystokv) -- only cntvct
+	 * register reads, then PSCI SYSTEM_RESET.  A reboot here proves the
+	 * TTBR1 switch itself survived; a hang means the switch aborted.
+	 *   (C10 stuck with the phystokv red paint in this slot, so that
+	 *    paint is the current prime suspect, not necessarily the switch.)
+	 */
+	{
+		unsigned long freq, t0, t;
+		__asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (freq));
+		__asm__ volatile ("mrs %0, cntvct_el0" : "=r" (t0));
+		do {
+			__asm__ volatile ("mrs %0, cntvct_el0" : "=r" (t));
+		} while ((t - t0) < freq * 6u);
+		{
+			register unsigned long x0 __asm__("x0") = 0x84000009UL;
+			register unsigned long x1 __asm__("x1") = 0;
+			register unsigned long x2 __asm__("x2") = 0;
+			register unsigned long x3 __asm__("x3") = 0;
+			__asm__ volatile ("smc #0" : "+r" (x0)
+			    : "r" (x1), "r" (x2), "r" (x3)
+			    : "memory", "cc");
+		}
+		for (;;) {
+			__asm__ volatile ("wfi");
+		}
+	}
 
 #if XNU_MONITOR
 	ml_enable_monitor();
